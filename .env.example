# ─── AI Assistant ─────────────────────────────────────────────────────────────
# Get a free Groq key at console.groq.com — no credit card required
# Free tier: 14,400 requests/day, 500 requests/minute
EXPO_PUBLIC_GROQ_API_KEY=gsk_your_key_here

# ─── Firebase Auth (optional) ─────────────────────────────────────────────────
# Without this the app works fully in guest mode
# Setup: console.firebase.google.com → Project Settings → Your Apps → Add Web App
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# ─── Google Books (optional) ──────────────────────────────────────────────────
# Gutenberg works without this. For Google Books higher rate limits:
# console.cloud.google.com → APIs → Books API → Credentials
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=
