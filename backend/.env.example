# Comma-separated is not supported here — this is a Python list via pydantic-settings;
# for local dev the default ["*"] in config.py is fine. Override in production:
# ALLOWED_ORIGINS=["https://yourapp.com"]

# Firebase project ID (find it in your Firebase console -> Project Settings)
FIREBASE_PROJECT_ID=

# Path to a Firebase service account JSON key file (Project Settings ->
# Service Accounts -> Generate new private key). Required for verifying
# ID tokens sent by the Expo app.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Phase 4: Groq API key (console.groq.com) — server-side only, never
# put this in the Expo app's .env.
GROQ_API_KEY=
# openai/gpt-oss-120b is Groq's current recommended general-purpose model
# as of July 2026 (llama-3.3-70b-versatile was deprecated 2026-06-17).
GROQ_MODEL=openai/gpt-oss-120b
