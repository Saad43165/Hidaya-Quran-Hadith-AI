{
  "expo": {
    "name": "IlmAI",
    "slug": "hidaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ilmai",
    "splash": {
      "image": "./assets/images/splashscreen.png",
      "resizeMode": "cover",
      "backgroundColor": "#0B1330"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ilmai.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "IlmAI uses your location to show accurate prayer times and Qibla direction.",
        "NSMotionUsageDescription": "IlmAI uses the compass sensor to show Qibla direction.",
        "NSMicrophoneUsageDescription": "IlmAI does not use the microphone."
      }
    },
    "android": {
      "package": "com.ilmai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1330"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-sensors",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IlmAI uses your location to show accurate prayer times and Qibla direction."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4A93E",
          "defaultChannel": "prayer-reminders",
          "sounds": []
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "privacyPolicyUrl": "https://gist.githubusercontent.com/Saad43165/fd193405dc0714aafca70569d3f60f07/raw/6ea4233587143fc9e80dfffd335a5f0ce5de2440/gistfile1.txt",
      "eas": {
        "projectId": "1b004f5f-07ab-4a0f-b21f-14dc011ad110"
      }
    },
    "owner": "saad112"
  }
}
