{
  "expo": {
    "name": "Hidaya",
    "slug": "hidaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kitaabai",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1330"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kitaabai.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KitaabAI uses your location to show accurate prayer times and Qibla direction.",
        "NSMotionUsageDescription": "KitaabAI uses the compass sensor to show Qibla direction.",
        "NSMicrophoneUsageDescription": "KitaabAI does not use the microphone."
      }
    },
    "android": {
      "package": "com.kitaabai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1330"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-sensors",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KitaabAI uses your location to show accurate prayer times and Qibla direction."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4A93E",
          "defaultChannel": "prayer-reminders",
          "sounds": []
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "1b004f5f-07ab-4a0f-b21f-14dc011ad110"
      }
    }
  }
}
